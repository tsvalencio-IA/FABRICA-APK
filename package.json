{
  "name": "compressor-videos-offline-apk-pc",
  "version": "3.0.0",
  "description": "App offline para PC e Android com o HTML conversor enviado pelo usuário.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "prepare:www": "node scripts/prepare-www.mjs",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "android:debug": "npm run prepare:www && npx cap sync android && cd android && ./gradlew assembleDebug",
    "electron:start": "electron .",
    "pc:win": "electron-builder --win nsis portable --x64",
    "pc:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.thiaguinho.compressoroffline.pc",
    "productName": "Compressor Offline thIAguinho",
    "directories": {
      "output": "dist-pc"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
